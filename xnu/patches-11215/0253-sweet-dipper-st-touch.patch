+/*
+ * Xiaomi Mi 8: ST FingerTipS. The controller keeps its firmware in flash, so
+ * nothing is uploaded here: release reset (shared with nothing else on the
+ * Mi 8), read the 8-byte system info block, drain what ABL/reboot left in the
+ * event stack and enable multi-touch sensing. Linux stmfts.c stmfts_power_on /
+ * stmfts_configure do the same with IRQ waits; here every step is polled.
+ */
+static int
+touch_st_info(uint8_t *info)
+{
+	memset(info, 0xa5, ST_INFO_LEN);
+	return touch_read(ST_ADDR, ST_READ_INFO, false, info, ST_INFO_LEN);
+}
+
+static int
+touch_st_present(void)
+{
+	uint8_t id = 0;
+	return touch_read(MXT_ADDR, 0, false, &id, 1);
+}
+
+static bool
+touch_dipper_start(void)
+{
+	uint8_t info[ST_INFO_LEN], status[ST_STATUS_LEN];
+
+	printf("SWEET TOUCH: TLMM rst%u=%#x/%#x irq%u=%#x/%#x sda=%#x scl=%#x\n",
+	    tb->rst, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    tb->irq, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl)));
+	/* fts,irq-flags = 0x2008: ONESHOT | TRIGGER_LOW, so idle high, low = event */
+	touch_gpio(tb->irq, 0, 3, 0, false, false);
+	if (st.bitbang) {
+		touch_gpio(tb->sda, 0, 0, 0, false, false);
+		touch_gpio(tb->scl, 0, 0, 0, false, false);
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->irq) + 8u, (1u << 4) | (3u << 2) | (1u << 1));
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->irq) + 0xcu, 0);
+	} else {
+		touch_gpio(tb->sda, tb->mux, 0, 0, false, false);
+		touch_gpio(tb->scl, tb->mux, 0, 0, false, false);
+	}
+	touch_gpio(tb->rst, 0, 0, 0, true, true);         /* reset released */
+	touch_wait(50);
+	st.probing = true;
+	int err = touch_st_info(info);
+	if (err) {
+		printf("SWEET TOUCH: ST FTS silent (%d); pulsing reset\n", err);
+		touch_gpio(tb->rst, 0, 0, 0, true, false);
+		touch_wait(10);
+		touch_gpio(tb->rst, 0, 0, 0, true, true);
+		touch_wait(300);
+		err = touch_st_info(info);
+	}
+	printf("SWEET TOUCH: probe ST FTS at %#x: err=%d fw=%u chip=%#x raw=%02x %02x %02x %02x\n",
+	    ST_ADDR, err, touch_be16(info + 2), touch_be16(info + 6),
+	    info[0], info[1], info[2], info[3]);
+	if (err || st.dead) {
+		int mxt = touch_st_present();
+		printf("SWEET TOUCH: no ST FTS at %#x (err=%d dead=%d); Atmel MXT at %#x err=%d%s\n",
+		    ST_ADDR, err, st.dead, MXT_ADDR, mxt,
+		    mxt ? "" : " (present, no driver yet)");
+		st.probing = false;
+		return false;
+	}
+	/* Drain the stack (CONTROLLER_READY after a reset, ABL leftovers), then sense. */
+	uint8_t drain[ST_EVENT_SIZE * ST_EVENTS_PER_READ];
+	for (unsigned i = 0; i < 4; ++i) {
+		memset(drain, 0, sizeof drain);
+		if (touch_read(ST_ADDR, ST_READ_ALL_EVENT, false, drain, sizeof drain) ||
+		    drain[0] == ST_EV_NO_EVENT) {
+			break;
+		}
+	}
+	int ce = touch_msg(ST_ADDR, (const uint8_t[]){ST_CLEAR_EVENTS}, 1, NULL, 0, false);
+	touch_wait(20);
+	int se = touch_msg(ST_ADDR, (const uint8_t[]){ST_MT_SENSE_ON}, 1, NULL, 0, false);
+	touch_wait(30);
+	int st_err = touch_read(ST_ADDR, ST_READ_STATUS, false, status, sizeof status);
+	printf("SWEET TOUCH: ST FTS clear=%d sense-on=%d status=%d/%#x\n",
+	    ce, se, st_err, st_err ? 0 : status[0]);
+	st.probing = false;
+	st.kind = TOUCH_ST;
+	return true;
+}
+
+/* One READ_ALL_EVENT read carries a run of 8-byte events, oldest first. */
+static int
+touch_st(void)
+{
+	uint8_t buf[ST_EVENT_SIZE * ST_EVENTS_PER_READ];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t seen = 0, up = 0;
+
+	for (unsigned pass = 0; pass < 4; ++pass) {
+		memset(buf, 0, sizeof buf);
+		int err = touch_read(ST_ADDR, ST_READ_ALL_EVENT, false, buf, sizeof buf);
+		if (err) {
+			return err;
+		}
+		bool full = true;
+		for (unsigned i = 0; i < ST_EVENTS_PER_READ; ++i) {
+			const uint8_t *e = buf + ST_EVENT_SIZE * i;
+			unsigned ev = e[0], id = ev & 0x0fu, slot = ev >> 4;
+			if (ev == ST_EV_NO_EVENT || ev == ST_EV_DEBUG) {
+				full = false;
+				break;
+			}
+			if (id != ST_EV_ENTER && id != ST_EV_MOTION && id != ST_EV_LEAVE) {
+				continue;                /* key/hover/error: not a contact */
+			}
+			if (slot >= TOUCH_MAX) {
+				continue;
+			}
+			if (id == ST_EV_LEAVE) {
+				up |= 1u << slot;
+				continue;
+			}
+			unsigned px = e[1] | ((unsigned)(e[2] & 0x0fu) << 8);
+			unsigned py = (e[2] >> 4) | ((unsigned)e[3] << 4);
+			if (px >= tb->w || py >= tb->h) {
+				continue;                /* stylus/glove coordinate scaling */
+			}
+			x[slot] = (int)px;
+			y[slot] = (int)py;
+			seen |= 1u << slot;
+		}
+		if (!full) {
+			break;
+		}
+	}
+	uint32_t mask = (st.active | seen) & ~up;
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		if ((mask & (1u << i)) && !(seen & (1u << i))) {
+			x[i] = st.x[i];        /* still down, no new sample in this read */
+			y[i] = st.y[i];
+		}
+	}
+	if (mask == st.active && !seen && !up) {
+		return 0;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+

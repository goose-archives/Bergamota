+/*
+ * 0260: SpringBoard's first launch after boot can end with the app alive but
+ * never presenting the lock screen (on beryllium a manual restart was the
+ * workaround). boot-arg sweetrestart=Name[,Name...] kills the named process
+ * once the boot has settled, then again if the panel is still off. It stops
+ * as soon as the OS turns the display back on or frames start flowing.
+ */
+static int
+sweet_restart_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_name_in(sweet_restart_names, name)) {
+		printf("SWEET RESTART: kill %s[%d]\n", name, proc_pid(p));
+		psignal(p, SIGKILL);
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_restart_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	uint64_t prev;
+
+	if (!PE_parse_boot_argn("sweetrestart", sweet_restart_names, sizeof(sweet_restart_names))) {
+		return;
+	}
+	if (sweet_restart_names[0] == '\0' || sweet_restart_names[0] == '-') {
+		return;
+	}
+	printf("SWEET RESTART: armed names=%s\n", sweet_restart_names);
+	(void)tsleep(&chan, PZERO, "sweetrst", 60 * hz);
+	prev = sweet_fb_swaps_now();
+	for (int i = 0; i < 3; i++) {
+		proc_iterate(PROC_ALLPROCLIST, sweet_restart_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "sweetrst", 30 * hz);
+		uint64_t now = sweet_fb_swaps_now();
+		printf("SWEET RESTART: try %d: power_off=%d swaps %llu -> %llu\n",
+		    i, sweet_fb_power_off(), prev, now);
+		if (!sweet_fb_power_off() || now > prev + 5) {
+			printf("SWEET RESTART: display is alive, stop\n");
+			break;
+		}
+		prev = now;
+	}
+}
+
 void
 sweet_sample_start(void)
 {
@@ -91,4 +152,7 @@
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	if (kernel_thread_start(sweet_restart_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }

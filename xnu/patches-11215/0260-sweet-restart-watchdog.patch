+/*
+ * 0260: what the display path is doing, for the restart watchdog in
+ * bsd/dev/sweet_sample.c. swaps counts SwapEnd calls since boot; powerOff is
+ * the last RequestPowerChange state (1 = the OS asked for the panel off).
+ */
+extern "C" uint64_t
+sweet_fb_swaps_now(void)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_shot_fb, __ATOMIC_ACQUIRE);
+	return fb != NULL ? fb->fSt.swaps : 0;
+}
+
+extern "C" int
+sweet_fb_power_off(void)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_shot_fb, __ATOMIC_ACQUIRE);
+	return fb == NULL || fb->fPowerOff ? 1 : 0;
+}

 /*
+ * 0261: eight horizontal SMPTE-ish bars over the whole panel, plus a white strip at the left edge, so a
+ * shifted/clipped scanout is obvious. Called from start() and from the vsync timer (iOS may write into the
+ * same memory, the bars are put back). fPixels is the kernel mapping of the boot framebuffer, which is frame 0,
+ * the buffer the MDP scans until the first swap.
+ */
+void
+AppleCLCD::testBars(void)
+{
+	static const uint32_t colors[8] = {
+		0xffffffff, 0xffffff00, 0xff00ffff, 0xff00ff00,
+		0xffff00ff, 0xffff0000, 0xff0000ff, 0xff000000,
+	};
+	uint32_t *base = (uint32_t *)fPixels;
+	const uint32_t bw = fWidth / 32;                 /* the white marker: 1/32 of the width */
+
+	if (base == 0 || fRowBytes == 0 || fHeight == 0) {
+		return;
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		uint32_t c = colors[(uint64_t)y * 8 / fHeight];
+		uint32_t *row = (uint32_t *)((uintptr_t)base + (uintptr_t)y * fRowBytes);
+		for (uint32_t x = 0; x < fWidth; x++) {
+			row[x] = x < bw ? 0xffffffff : c;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (fTestLogged) {
+		return;
+	}
+	fTestLogged = 1;
+	uint32_t src = 0, stride = 0;
+	if (fMdp != 0 && fPipe >= 0) {
+		volatile uint32_t *p = (volatile uint32_t *)(fMdp + sweet_mdp_pipes[fPipe].off);
+		src = p[SSPP_SRC0_ADDR / 4];
+		stride = p[SSPP_YSTRIDE0 / 4];
+	}
+	IOLog("SWEET FBTEST: bars on the panel: the MDP scans 0x%x stride 0x%x (frame 0 is 0x%llx, %ux%u stride %u), front %u hw %d\n",
+	    src, stride, fPhys, fWidth, fHeight, fRowBytes, fFront, fHwOn ? 1 : 0);
+}

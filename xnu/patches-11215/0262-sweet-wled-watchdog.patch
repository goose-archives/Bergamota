+/*
+ * 0262: the PMI8998 WLED module can be switched off a couple of seconds after the bootloader hands over (dipper:
+ * the boot screen is visible, then the panel goes black even though the MDP keeps scanning). Enxerto kicks the
+ * module every 250 ms while it runs (pmic_wled_watchdog); once xnu starts nobody does, so do the same here once a
+ * second: if the module enable bit went away, put it back; if we think the backlight is on and the strings read
+ * zero, light them again. A deliberate power off (fBlPos == 0, iOS asked) is left alone.
+ */
+void
+AppleCLCD::blWatchdog(void)
+{
+	uint8_t mod = 0;
+	uint16_t lvl[2] = { 0xffff, 0xffff };
+	bool modBack = false, dark = false, wanted;
+
+	if (sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_MOD_EN, &mod) == 0 && !(mod & 0x80)) {
+		uint8_t on = (uint8_t)(mod | 0x80);
+		modBack = sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_MOD_EN, &on, 1) == 0;
+	}
+	if (sweet_wled_read16(0, &lvl[0]) == 0 && sweet_wled_read16(1, &lvl[1]) == 0) {
+		dark = ((lvl[0] | lvl[1]) & 0xfff) == 0;
+	}
+	if (!modBack && !dark) {
+		return;
+	}
+	wanted = (fTestUntil != 0 && mach_absolute_time() < fTestUntil) ||
+	    (fBlOK && fBlPos == SWEET_FB_BL_STEPS);
+	if (!wanted) {
+		return;                 /* iOS asked for the panel off (or it never came on): do not fight it */
+	}
+	if (fBlRaw[0] == 0 || fBlRaw[1] == 0) {
+		fBlRaw[0] = fBlRaw[1] = 0x7ff;  /* nothing known: a level the strings can show */
+	}
+	/* the module is back or the strings read zero: write the level again and latch it (blSet without the logs) */
+	for (unsigned n = 0; n < SWEET_WLED_STRINGS; n++) {
+		uint8_t d[2] = { (uint8_t)fBlRaw[n], (uint8_t)(fBlRaw[n] >> 8) };
+		(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_BRIGHT(n), d, 2);
+	}
+	uint8_t clr = 0, set = SWEET_WLED_SYNC_MASK;
+	(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &clr, 1);
+	(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &set, 1);
+	fBlPos = SWEET_FB_BL_STEPS;
+	fBlOK = true;
+	if (fBlFixLogged < 8) {
+		fBlFixLogged++;
+		IOLog("SWEET FB: WLED was off after the handoff (MOD_EN 0x%02x%s, strings 0x%04x/0x%04x%s): back on at 0x%04x\n",
+		    mod, modBack ? " restored" : "", lvl[0], lvl[1], dark ? " relit" : "", fBlRaw[0]);
+	}
+}

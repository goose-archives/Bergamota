+/*
+ * PMI8998 WLED backlight (SID 3; reg = <0xd800>, <0xd900> in pmi8998.dtsi;
+ * Linux drivers/video/backlight/qcom-wled.c, WLED4): sink base 0xd900,
+ * WLED4_SINK_REG_BRIGHT(n) = +0x57 + 0x10 * n (16 bit little endian, max
+ * 0xfff), WLED3_SINK_REG_SYNC +0x47 (clear, then set the string mask to
+ * latch a new brightness). Poco F1 has two strings (qcom,num-strings = 2).
+ * The control module (0xd846 MOD_EN bit 7) is only ever added back by the
+ * 0262 watchdog; the fade itself only moves the brightness.
+ */
+#define SWEET_WLED_SID          3
+#define SWEET_WLED_SINK         0xd900u
+#define SWEET_WLED_MOD_EN       0xd846u
+#define SWEET_WLED_SYNC         (SWEET_WLED_SINK + 0x47u)
+#define SWEET_WLED_BRIGHT(n)    (SWEET_WLED_SINK + 0x57u + 0x10u * (n))
+#define SWEET_WLED_STRINGS      2
+#define SWEET_WLED_SYNC_MASK    0x0fu   /* GENMASK(max_string_count - 1, 0), WLED4: 4 */

 /*
+ * 0263: one line a second while sweetfbtest holds the panel: the WLED module and its strings, the backlight state
+ * xnu believes in, and the MDP pipe (scan address, stride, INTF1 frames drawn since the last line). The deadline of
+ * 0261 was wrong (clock_interval_to_deadline takes nanoseconds, the call passed milliseconds), so the bars were only
+ * held for a fraction of a second and the log of the moment they disappear did not exist. This is that log.
+ */
+void
+AppleCLCD::testLog(void)
+{
+	static const uint32_t marks[4] = { 90, 180, 360, 900 };      /* 3, 6, 12, 30 s at 30 Hz */
+	static const char *const names[4] = { "3 s", "6 s", "12 s", "30 s" };
+	uint8_t mod = 0, sync = 0;
+	uint16_t l0 = 0xffff, l1 = 0xffff;
+	uint32_t src = 0, stride = 0, frames = 0, drew = 0;
+
+	(void)sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_MOD_EN, &mod);
+	(void)sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_SYNC, &sync);
+	(void)sweet_wled_read16(0, &l0);
+	(void)sweet_wled_read16(1, &l1);
+	if (fMdp != 0) {
+		if (fPipe >= 0) {
+			volatile uint32_t *p = (volatile uint32_t *)(fMdp + sweet_mdp_pipes[fPipe].off);
+			src = p[SSPP_SRC0_ADDR / 4];
+			stride = p[SSPP_YSTRIDE0 / 4];
+		}
+		frames = mdp_rd(fMdp + SWEET_MDP_INTF1, 0xac);
+		drew = frames - fTestFrames;
+		fTestFrames = frames;
+	}
+	IOLog("SWEET FBTEST: t=%u s: mod 0x%02x sync 0x%02x wled 0x%04x/0x%04x want 0x%04x blpos %u ok %d pwr %d front %u hw %d mdp 0x%x/0x%x intf %u (+%u) swaps %llu\n",
+	    fTestTick / 30, mod, sync, l0, l1, fBlRaw[0], fBlPos, fBlOK ? 1 : 0, fPowerOff ? 1 : 0,
+	    fFront, fHwOn ? 1 : 0, src, stride, frames, drew, fSt.swaps);
+	for (uint32_t i = 0; i < 4; i++) {
+		if (fTestTick >= marks[i] && !(fTestDumpMask & (1u << i))) {
+			fTestDumpMask |= 1u << i;
+			testDumpRegs(names[i]);
+		}
+	}
+}
+
+/* 0263: the PMI8998 WLED control (0xd8) and sink (0xd9) blocks, 16 bytes a line; 0xff means the read failed. */
+void
+AppleCLCD::testDumpRegs(const char *why)
+{
+	static const char hex[] = "0123456789abcdef";
+
+	for (unsigned base = 0xd800; base <= 0xd900; base += 0x100) {
+		for (unsigned off = 0; off < 0x100; off += 16) {
+			char line[16 * 3 + 1];
+			uint32_t bad = 0;
+			for (unsigned i = 0; i < 16; i++) {
+				uint8_t v = 0;
+				if (sweet_spmi_read(SWEET_WLED_SID, base + off + i, &v) != 0) {
+					v = 0xff;
+					bad++;
+				}
+				line[i * 3 + 0] = hex[v >> 4];
+				line[i * 3 + 1] = hex[v & 0xf];
+				line[i * 3 + 2] = ' ';
+			}
+			line[16 * 3] = 0;
+			IOLog("SWEET FBTEST: wled %s t=%u 0x%03x: %s%s\n", why, fTestTick / 30, base + off, line,
+			    bad ? "(ff = read failed)" : "");
+		}
+	}
+}

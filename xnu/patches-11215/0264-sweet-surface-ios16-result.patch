+/* How much room the caller left for the record (IOSurface.framework asks for 0xa68 on iOS 16, 0xc68 on iOS 18). */
+static uint32_t
+sweet_struct_out_capacity(IOExternalMethodArguments *args)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		return (uint32_t)args->structureOutputDescriptor->getLength();
+	}
+	return args->structureOutputSize;
+}

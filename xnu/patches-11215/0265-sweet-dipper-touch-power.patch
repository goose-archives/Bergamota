+/* Free a slave that is holding SDA low (mid-byte after a lost STOP). */
+static void
+bb_recover(void)
+{
+	if (bb_get(tb->sda) && bb_get(tb->scl)) {
+		return;
+	}
+	bb_line(tb->sda, true);
+	for (unsigned i = 0; i < 9; ++i) {
+		bb_line(tb->scl, false);
+		delay(BB_HALF_US);
+		bb_line(tb->scl, true);
+		delay(BB_HALF_US);
+	}
+	bb_stop();
+}
+
+/* Address-only write: START, addr+W, STOP. No register byte is sent. */
+static bool
+bb_probe(uint8_t addr)
+{
+	if (!bb_start()) {
+		return false;
+	}
+	bool ack = bb_write((uint8_t)(addr << 1)) == 0;
+	bb_stop();
+	return ack;
+}

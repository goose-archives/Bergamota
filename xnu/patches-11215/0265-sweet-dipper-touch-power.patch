+/* How many microseconds does a released line need to read high? */
+static void
+bb_rise_test(const char *name, unsigned pin)
+{
+	touch_wr(st.gpio, TOUCH_GPIO_IO(pin), touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u);
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(pin), touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)) | 0x200u);
+	delay(20);
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(pin), touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)) & ~0x200u);
+	for (unsigned us = 0; us < 60; ++us) {
+		if (bb_get(pin)) {
+			printf("SWEET TOUCH: rise %s %uus (cfg=%#x)\n", name, us,
+			    touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)));
+			return;
+		}
+		delay(1);
+	}
+	printf("SWEET TOUCH: rise %s still low after 60us\n", name);
+}

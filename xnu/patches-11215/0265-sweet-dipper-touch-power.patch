+
+/* Wait for a controller event; every command posts one on this firmware. */
+static int
+touch_st_wait(uint8_t want, unsigned tries)
+{
+	uint8_t e[ST_EVENT_SIZE];
+	unsigned shown = 0;
+
+	for (unsigned i = 0; i < tries; ++i) {
+		if (!touch_st_one(e) && e[0]) {
+			if (st.probing && shown < 6) {
+				++shown;
+				printf("SWEET TOUCH: wait ev %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+			}
+			if (e[0] == want) {
+				return 0;
+			}
+		}
+		touch_wait(10);
+	}
+	return ETIMEDOUT;
+}
+
+/*
+ * Send one ST command and wait for the controller event Linux treats as its
+ * completion (struct stmfts_data::cmd_done): CONTROLLER_READY 0x10,
+ * SLEEP_OUT_CONTROLLER_READY 0x11 or STATUS 0x16. Returns 0 on ACK, an errno
+ * when the write itself was NACKed.
+ */
+static int __unused
+touch_st_cmd(uint8_t cmd)
+{
+	int err = touch_msg(ST_ADDR, &cmd, 1, NULL, 0, false);
+
+	if (err) {
+		return err;
+	}
+	bool shown = false;
+	for (unsigned i = 0; i < 100; ++i) {
+		uint8_t ev[ST_EVENT_SIZE * ST_EVENTS_PER_READ];
+		touch_wait(10);
+		if (touch_st_one(ev)) {
+			return 0;        /* controller is still rebooting */
+		}
+		if (!shown && st.probing) {
+			shown = true;
+			printf("SWEET TOUCH: ST cmd %#x ev=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    cmd, ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+		for (unsigned j = 0; j < ST_EVENTS_PER_READ; ++j) {
+			uint8_t e = ev[j * ST_EVENT_SIZE];
+			if (e == ST_EV_NO_EVENT) {
+				break;
+			}
+			if (e == 0x10u || e == 0x11u || e == 0x16u) {
+				if (st.probing) {
+					printf("SWEET TOUCH: ST cmd %#x -> event %#x\n",
+					    cmd, e);
+				}
+				return 0;
+			}
+		}
+	}
+	if (st.probing) {
+		printf("SWEET TOUCH: ST cmd %#x: no completion event\n", cmd);
+	}
+	return 0;
+}

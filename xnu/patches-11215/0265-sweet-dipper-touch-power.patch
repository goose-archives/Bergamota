 static int
 touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
     unsigned nr, bool stretch)
 {
+	/*
+	 * SE14 on dipper runs GSI-only firmware: its FIFO interface is disabled
+	 * and the GENI command path below never completes. Worse, touch_abort()
+	 * then sets st.dead, which stops the polling thread entirely. Dipper
+	 * talks to the controller over the same bit-banged pins as touch_read().
+	 */
+	if (st.bitbang) {
+		if (nr || !nt || nt > 2) {
+			return EINVAL;
+		}
+		return bb_xfer(addr, tx, nt, NULL, 0);
+	}
 	st.irq_status = st.irq_last = 0;
 	st.sent = st.got = 0;
 	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
@@ -1029,6 +1055,47 @@

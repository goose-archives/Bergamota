+/* Poll the info register across a boot window; irq tells if the core is alive. */
+static void
+touch_st_poll(const char *tag)
+{
+	uint8_t b[8];
+	for (unsigned i = 0; i < 20; ++i) {
+		memset(b, 0, sizeof b);
+		int e = bb_xfer(ST_ADDR, (const uint8_t[]){ST_READ_INFO}, 1, b, 8);
+		if (i == 0 || b[0] || b[1] || b[2] || b[3]) {
+			printf("SWEET TOUCH: %s t=%ums info err=%d irq=%d sda=%d:"
+			    " %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    tag, i * 100u, e, bb_get(tb->irq), bb_get(tb->sda),
+			    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+		}
+		if (b[0] || b[1] || b[2] || b[3]) {
+			return;
+		}
+		touch_wait(100);
+	}
+}
+
+/* Raw register read, printed as bytes, for bring-up diagnosis. */
+static void
+touch_st_raw(const char *tag, uint8_t reg, bool wide)
+{
+	uint8_t b[8];
+	uint8_t ptr[2] = {reg, 0};
+	int err = bb_xfer(ST_ADDR, ptr, wide ? 2u : 1u, b, sizeof b);
+	printf("SWEET TOUCH: raw %s %#x %s err=%d sda=%d scl=%d:"
+	    " %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    tag, reg, wide ? "p2" : "p1", err, bb_get(tb->sda), bb_get(tb->scl),
+	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+}
